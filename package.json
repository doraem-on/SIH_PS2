{
  "name": "bhoomi-suraksha",
  "version": "2.1.0",
  "private": true,
  "description": "Evidence-led geospatial harmonization and relocation decision support",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "node scripts/start.mjs",
    "test": "node --test tests/http-policy.test.mjs && .venv/bin/python -m pytest tests -q",
    "train": ".venv/bin/python ml/train.py",
    "setup": "bash scripts/setup.sh",
    "prebuild": "node scripts/prepare-assets.mjs",
    "predev": "node scripts/prepare-assets.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.11.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "prettier": "^3.9.9",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
