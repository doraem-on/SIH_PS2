PORT=3000
# Optional custom Python executable (default: .venv/bin/python)
# PYTHON=/absolute/path/to/python
# Optional workspace database location
# BHOOMI_DB=/absolute/path/to/workspace.sqlite
# Public deployment (requires HTTPS and a persistent mounted directory):
# BHOOMI_DEPLOYMENT_MODE=public
# BHOOMI_WORKSPACE_DIR=/workspace
# PUBLIC_ORIGIN=https://your-domain.example
# HOST=0.0.0.0
# API_PORT=8001
# BHOOMI_STORAGE_EPHEMERAL=true
